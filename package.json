{
  "name": "dsh-quota-bar-cn",
  "version": "0.1.1",
  "description": "在 DSH 会话视图顶部常驻一条额度胶囊，实时显示 DeepSeek 账号的今日已用金额与剩余额度。余额偏低自动变色提醒，单击刷新，双击剩余额度跳转 DeepSeek 官方用量页。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quota",
    "balance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetiredPhysicist/dsh-plugins.git",
    "directory": "packages/dsh-quota-bar"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
